{
  "manifest_version": 3,
  "name": "Chrome Lock",
  "version": "0.2.0",
  "description": "Password lock for a Chrome profile. Locking encrypts and closes your tabs; only your password brings them back.",
  "minimum_chrome_version": "120",
  "incognito": "split",
  "permissions": ["storage", "tabs", "tabGroups", "idle", "alarms"],
  "commands": {
    "lock-now": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Lock this Chrome profile"
    }
  },
  "background": {
    "service_worker": "src/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Chrome Lock"
  }
}
