{
  "manifest_version": 3,
  "name": "Chrome Lock",
  "version": "0.6.0",
  "description": "Password lock for a Chrome profile. Locking encrypts and closes your tabs; only your password brings them back.",
  "minimum_chrome_version": "120",
  "incognito": "split",
  "permissions": ["storage", "tabs", "tabGroups", "idle", "alarms"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; style-src 'self'; img-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'"
  },
  "storage": {
    "managed_schema": "managed-schema.json"
  },
  "commands": {
    "lock-now": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Lock this Chrome profile"
    }
  },
  "background": {
    "service_worker": "src/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Chrome Lock"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
